{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtue-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["5 * * * *", "20 0 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "virtue-app-db",
      "database_id": "6e168c6f-db0f-44f1-8a87-cbce8eb94179",
      "migrations_dir": "src/schema/migrations"
    },
    {
      "binding": "DONATE_DB",
      "database_name": "virtue-donate-db",
      "database_id": "59a490ce-e6de-4b44-a1d2-8b96be0d9dda",
      "migrations_dir": "../api-donate/src/schema/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "virtue-app-bucket"
    }
  ],
  "vars": {
    "JWT_ACCESS_EXPIRY": "15m",
    "JWT_REFRESH_EXPIRY": "7d",
    "JWT_PUBLIC_KEY": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAGnH17UlZo066wnSu04M6LUQO3F3CbsgAmMML1J/cNY8=\n-----END PUBLIC KEY-----",
    "API_BASE_PATH": "/api",
    "R2_URL": "https://virtue-r2.yaseed.net",
    "APP_URL": "https://virtue.yaseed.net",
    "LANDING_URL": "https://virtueinitiative.org",
    "APP_NAME": "Virtue Initiative",
    "EMAIL_DELIVERY_MODE": "smtp",
    "HASH_SERVER_URL": "https://virtue-hash.yaseed.net",
    "BUG_REPORT_EMAIL": "samuel.j.schneider@gmail.com",
    "SMTP_HOST": "w0202169.kasserver.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "virtue@yaseed.net",
    "SMTP_FROM_EMAIL": "virtue@yaseed.net"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "virtue.yaseed.net/api/*",
      "zone_name": "yaseed.net"
    }
  ]
}
