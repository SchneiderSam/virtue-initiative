{
  "$schema": "../../api/node_modules/wrangler/config-schema.json",
  "name": "virtue-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-23",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["30 2 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "virtue-app-db",
      "database_id": "6e168c6f-db0f-44f1-8a87-cbce8eb94179"
    },
    {
      "binding": "DONATE_DB",
      "database_name": "virtue-donate-db",
      "database_id": "59a490ce-e6de-4b44-a1d2-8b96be0d9dda"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP",
      "bucket_name": "virtue-backup"
    }
  ]
}
